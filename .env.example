# Backend base URL (no trailing slash, no /api). Sail serves on port 80; the Android emulator reaches the host as 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost

# Realtime chat (Laravel Reverb). The app key is public by design (the website ships it to browsers too).
# Host defaults to the API host; Android emulators reach the machine as 10.0.2.2.
EXPO_PUBLIC_REVERB_KEY=2aeurwkubfp7d5yd29c9
EXPO_PUBLIC_REVERB_PORT=8080

# Google sign-in (Android): the OAuth *web* client id of the Google Cloud project, the backend's GOOGLE_CLIENT_ID. Public by design.
# The app's package name (app.summitsync) and signing-key SHA-1 must also be registered as an Android OAuth client in Google Cloud.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
